StringReaderTest:test("expect_correct", function()
	local reader = StringReader.new("abc")
	reader:expect("a")
	assertThat(reader:getCursor(), is(1))
end)

StringReaderTest:test("expect_incorrect", function()
	local reader = StringReader.new("bcd")
	local ex = JUnit.assertThrows(CommandSyntaxException, function()
		reader:expect("a")
	end)
	assertThat(ex:getType(), is(CommandSyntaxException.BUILT_IN_EXCEPTIONS:readerExpectedSymbol()))
	assertThat(ex:getCursor(), is(0))
end)

StringReaderTest:test("expect_none", function()
	local reader = StringReader.new("")
	local ex = JUnit.assertThrows(CommandSyntaxException, function()
		reader:expect("a")
	end)
	assertThat(ex:getType(), is(CommandSyntaxException.BUILT_IN_EXCEPTIONS:readerExpectedSymbol()))
	assertThat(ex:getCursor(), is(0))
end)

