local B = require("./lib/load")
local JUnit = require("./lib/JUnit")
local Hamcrest = require("./lib/Hamcrest")
local Class = require("./lib/Class")
local StringReader = B.StringReader
local CommandSyntaxException = B.CommandSyntaxException
local assertThat, is, equalTo = Hamcrest.assertThat, Hamcrest.is, Hamcrest.equalTo

local StringReaderTest = JUnit.suite("StringReaderTest")

-- A Java float literal such as 12.34f, rounded to single precision as readFloat rounds.
local function float(value: number): number
	return string.unpack("<f", string.pack("<f", value)) :: number
end

-- `try { ... } catch (final CommandSyntaxException ex) { ... }` without fail(): like the Java, the
-- test also passes when nothing is thrown.
local function tryCatch(body: () -> (), handler: (ex: any) -> ())
	local ok, err = pcall(body)
	if ok then
		return
	end
	if not Class.isInstance(err, CommandSyntaxException) then
		error(err, 0)
	end
	handler(err)
end

StringReaderTest:test("canRead", function()
	local reader = StringReader.new("abc")
	assertThat(reader:canRead(), is(true))
	reader:skip() -- 'a'
	assertThat(reader:canRead(), is(true))
	reader:skip() -- 'b'
	assertThat(reader:canRead(), is(true))
	reader:skip() -- 'c'
	assertThat(reader:canRead(), is(false))
end)

StringReaderTest:test("getRemainingLength", function()
	local reader = StringReader.new("abc")
	assertThat(reader:getRemainingLength(), is(3))
	reader:setCursor(1)
	assertThat(reader:getRemainingLength(), is(2))
	reader:setCursor(2)
	assertThat(reader:getRemainingLength(), is(1))
	reader:setCursor(3)
	assertThat(reader:getRemainingLength(), is(0))
end)

StringReaderTest:test("canRead_length", function()
	local reader = StringReader.new("abc")
	assertThat(reader:canRead(1), is(true))
	assertThat(reader:canRead(2), is(true))
	assertThat(reader:canRead(3), is(true))
	assertThat(reader:canRead(4), is(false))
	assertThat(reader:canRead(5), is(false))
end)

StringReaderTest:test("peek", function()
	local reader = StringReader.new("abc")
	assertThat(reader:peek(), is("a"))
	assertThat(reader:getCursor(), is(0))
	reader:setCursor(2)
	assertThat(reader:peek(), is("c"))
	assertThat(reader:getCursor(), is(2))
end)

StringReaderTest:test("peek_length", function()
	local reader = StringReader.new("abc")
	assertThat(reader:peek(0), is("a"))
	assertThat(reader:peek(2), is("c"))
	assertThat(reader:getCursor(), is(0))
	reader:setCursor(1)
	assertThat(reader:peek(1), is("c"))
	assertThat(reader:getCursor(), is(1))
end)

